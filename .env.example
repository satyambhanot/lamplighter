# Copy to .env and fill in. Never commit the real .env file.

# Dispatcher note generation (falls back to a template if unset)
ANTHROPIC_API_KEY=

# Voice agent
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Shared secret the ElevenLabs webhook tools must send; the API rejects
# report/status calls without it.
VOICE_SHARED_SECRET=

# Dashboard server sends this header for plan confirmation and repairs.
DISPATCH_SHARED_SECRET=

# Optional API connection override for the dashboard.
LAMPLIGHTER_API_URL=http://localhost:8000

# Salt used to hash caller phone numbers before they are stored.
PHONE_HASH_SALT=

# Tunnel to the local API during the demo. Add the authtoken with
# `ngrok config add-authtoken ...`; NGROK_DOMAIN is your free fixed domain
# from the ngrok dashboard (Domains), host only, e.g. abc.ngrok-free.app.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Written by `make voice`; keep them so re-runs update the same agent.
ELEVENLABS_VOICE_SECRET_ID=
ELEVENLABS_REPORT_TOOL_ID=
ELEVENLABS_STATUS_TOOL_ID=
